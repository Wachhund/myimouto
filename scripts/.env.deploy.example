# Deploy configuration for MyImouto
# Copy to scripts/.env.deploy and adjust values.
# This file is NOT committed (see .gitignore).

DEPLOY_USER=vps
DEPLOY_HOST=your-server.example.com
DEPLOY_BASE=/home/vps
PROJECT_NAME=myimouto
PHP_BIN=php
COMPOSER_BIN=composer
KEEP_RELEASES=5
SMOKE_URL=http://127.0.0.1
WEB_GROUP=www-data
